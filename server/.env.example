# Copy to server/.env and fill in. Never expose these keys to the browser.
PORT=3001
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://lxmpqprsopkdnfwanddr.supabase.co
# Supabase dashboard → Project Settings → API Keys → secret / service_role key (needed to save results)
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI providers — methods that need a missing key are shown as unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# https://huggingface.co/settings/tokens (a "Read" token with Inference Providers permission)
HF_TOKEN=

MAX_ITEMS_PER_RUN=500

# Development only: skip Supabase Auth token checks on the API (never enable in production).
AUTH_DISABLED=false
