# Copy to e2e/.env (git-ignored) and fill in. Never commit the real file.

# Required: Supabase service-role key (Supabase → Project Settings → API keys → service_role).
# Used only to create and delete throw-away e2e-*@example.com test users.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults shown). Use http://localhost:5173 / http://localhost:3001 to test a local dev server.
# E2E_BASE_URL=https://warm-mousse-9e6c33.netlify.app
# E2E_API_URL=https://nlp-workbench-api.onrender.com
# E2E_SUPABASE_URL=https://lxmpqprsopkdnfwanddr.supabase.co

# Optional: 1 = also test OpenAI methods (costs a little money; needs credits on the account).
# E2E_OPENAI=0
# Optional: 1 = skip Hugging Face methods (e.g. when the free inference quota is exhausted).
# E2E_SKIP_HF=0
