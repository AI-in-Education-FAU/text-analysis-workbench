{
  "name": "workbench-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for the Text Analysis Workbench (website + analysis API)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api.spec.js",
